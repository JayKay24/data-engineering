{
  "type": "record",
  "name": "EcommerceEvent",
  "namespace": "com.dataengineering.realtime.ecommerce",
  "doc": "Schema definition for real-time e-commerce user activity and transaction events.",
  "fields": [
    {
      "name": "user_id",
      "type": "string",
      "doc": "Unique identifier of the user generating the event."
    },
    {
      "name": "url",
      "type": "string",
      "doc": "Web page URL visited by the user."
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Interaction type (e.g., view, click, add_to_cart, purchase)."
    },
    {
      "name": "event_time",
      "type": "string",
      "doc": "ISO-8601 formatted timestamp of the event occurrence."
    },
    {
      "name": "product_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Product ID associated with the interaction."
    },
    {
      "name": "category",
      "type": ["null", "string"],
      "default": null,
      "doc": "Product category (e.g., electronics, apparel, home)."
    },
    {
      "name": "price",
      "type": ["null", "double"],
      "default": null,
      "doc": "Product unit price or transaction amount."
    },
    {
      "name": "ip_address",
      "type": ["null", "string"],
      "default": null,
      "doc": "Client IP address."
    },
    {
      "name": "user_agent",
      "type": ["null", "string"],
      "default": null,
      "doc": "Client browser user agent."
    }
  ]
}
